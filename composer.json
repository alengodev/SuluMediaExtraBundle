{
    "name": "alengo/sulu-media-extra-bundle",
    "description": "Media utilities for Sulu CMS — @2x crop sync, format generation, media rename command",
    "type": "symfony-bundle",
    "homepage": "https://github.com/alengodev/SuluMediaExtraBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Huber-De Monte"
        }
    ],
    "require": {
        "php": "^8.2",
        "sulu/sulu": "~3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\SuluMediaExtraBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alengo\\SuluMediaExtraBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
